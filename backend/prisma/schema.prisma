// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- 1. QUẢN LÝ NGƯỜI DÙNG & BẢO MẬT ---

model User {
  user_id       BigInt    @id @default(autoincrement())
  role          UserRole
  full_name     String    @db.VarChar(150)
  email         String    @unique @db.VarChar(150)
  phone         String    @unique @db.VarChar(20)
  password_hash String    @db.VarChar(255)
  avatar_url    String?   @db.VarChar(255)
  status        UserStatus @default(active)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Quan hệ 1-N [cite: 330-350]
  patient_profiles      PatientProfile[]
  refresh_tokens        RefreshToken[]
  password_reset_tokens PasswordResetToken[]
  doctor                Doctor?
  appointments          Appointment[]
  status_logs           AppointmentStatusLog[]
  reviews               DoctorReview[]
  submitted_forms       PreVisitForm[]         @relation("SubmittedByUser")
  reviewed_forms        PreVisitForm[]         @relation("ReviewedByUser")
  notifications         Notification[]
  ai_triage_sessions    AiTriageSession[]
  admin_notif_settings  AdminNotificationSetting?

  @@map("tblUser")
}

model AdminNotificationSetting {
  id                  BigInt   @id @default(autoincrement())
  userId              BigInt   @unique
  pushEnabled         Int      @default(1) @db.TinyInt
  soundEnabled        Int      @default(1) @db.TinyInt
  appointmentReminder Int      @default(0) @db.TinyInt
  statusUpdates       Int      @default(1) @db.TinyInt
  reminderLeadMinutes Int      @default(30)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@map("tblAdminNotificationSettings")
}

enum UserRole {
  admin
  doctor
  patient
}

enum UserStatus {
  active
  inactive
  blocked
}

model RefreshToken {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  token      String   @unique @db.VarChar(512)
  expires_at DateTime
  is_revoked Int      @default(0) @db.TinyInt
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("tblRefreshTokens")
}

model PasswordResetToken {
  id         BigInt           @id @default(autoincrement())
  user_id    BigInt
  token      String           @unique @db.VarChar(512)
  status     PasswordResetStatus @default(PENDING)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime         @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("tblPasswordResetTokens")
}

enum PasswordResetStatus {
  PENDING
  USED
  EXPIRED
}

// --- 2. HỒ SƠ BỆNH NHÂN & Y TẾ ---

model PatientProfile {
  patient_id          BigInt   @id @default(autoincrement())
  user_id             BigInt
  full_name           String   @db.VarChar(150)
  phone_number        String?  @unique @db.VarChar(20)
  gender              Gender?
  date_of_birth       DateTime? @db.Date
  blood_type          String?  @db.VarChar(10)
  occupation          String?  @db.VarChar(100)
  ethnicity           String?  @db.VarChar(100)
  nationality         String?  @db.VarChar(100)
  address_detail      String?  @db.VarChar(255)
  province            String?  @db.VarChar(100)
  district            String?  @db.VarChar(100)
  ward                String?  @db.VarChar(100)
  citizen_id          String?  @unique @db.VarChar(30)
  insurance_number    String?  @db.VarChar(50)
  email               String?  @db.VarChar(150)
  medical_conditions  String?  @db.Text
  allergies           String?  @db.Text
  emergency_contact   String?  @db.VarChar(100)
  relationship_to_user String? @db.VarChar(50)
  is_primary          Int      @default(0) @db.TinyInt
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  appointments   Appointment[]
  medical_records MedicalRecord[]

  @@map("tblPatientProfile")
}

enum Gender {
  male
  female
  other
}

// --- 3. CƠ SỞ VẬT CHẤT & CHUYÊN KHOA ---

model Specialty {
  specialty_id BigInt  @id @default(autoincrement())
  name         String  @unique @db.VarChar(150)
  description  String? @db.Text
  isActive    Int     @default(1) @db.TinyInt

  doctors Doctor[]
  rooms   Room[]

  @@map("tblSpecialty")
}

model Room {
  room_id     BigInt     @id @default(autoincrement())
  specialty_id BigInt?
  name        String     @db.VarChar(100)
  code        String     @unique @db.VarChar(20)
  floor       Int?       @db.SmallInt
  description String?    @db.Text
  is_active   Int        @default(1) @db.TinyInt
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  specialty   Specialty? @relation(fields: [specialty_id], references: [specialty_id])
  schedules   Schedule[]

  @@map("tblRoom")
}

model Facility {
  facility_id    BigInt       @id @default(autoincrement())
  name           String       @db.VarChar(200)
  facility_type  FacilityType
  phone          String?      @db.VarChar(20)
  email          String?      @db.VarChar(150)
  address_detail String       @db.VarChar(255)
  province       String?      @db.VarChar(100)
  district       String?      @db.VarChar(100)
  ward           String?      @db.VarChar(100)
  opening_hours  String?      @db.VarChar(255)
  rating_avg     Decimal      @default(0.0) @db.Decimal(2, 1)
  is_active      Int          @default(1) @db.TinyInt
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  doctors      Doctor[]
  services     Service[]
  slots        Slot[]
  appointments Appointment[]

  @@map("tblFacility")
}

enum FacilityType {
  hospital
  clinic
  vaccination_center
}

// --- 4. BÁC SĨ & DỊCH VỤ ---

model Doctor {
  doctor_id        BigInt   @id @default(autoincrement())
  user_id          BigInt   @unique
  full_name        String   @db.VarChar(150)
  specialty_id     BigInt
  facility_id      BigInt
  title            String?  @db.VarChar(100)
  bio              String?  @db.Text
  experience_years Int?
  license_number   String?  @unique @db.VarChar(50)
  avatar_url       String?  @db.VarChar(255)
  consultation_fee Decimal? @db.Decimal(12, 2)
  is_active        Int      @default(1) @db.TinyInt
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user      User      @relation(fields: [user_id], references: [user_id])
  specialty Specialty @relation(fields: [specialty_id], references: [specialty_id])
  facility  Facility  @relation(fields: [facility_id], references: [facility_id])

  appointments    Appointment[]
  slots           Slot[]
  schedules       Schedule[]
  medical_records MedicalRecord[]
  reviews         DoctorReview[]

  @@map("tblDoctor")
}

model Schedule {
  scheduleId      BigInt   @id @default(autoincrement())
  doctor_id       BigInt
  room_id         BigInt?
  workDate        DateTime @db.Date
  startTime       DateTime @db.Time
  endTime         DateTime @db.Time
  slotDuration    Int      @default(30)
  maxSlots        Int
  is_active       Int      @default(1) @db.TinyInt
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  doctor          Doctor   @relation(fields: [doctor_id], references: [doctor_id])
  room            Room?    @relation(fields: [room_id], references: [room_id])
  appointments    Appointment[]

  @@map("tblSchedule")
}

model Service {
  service_id       BigInt   @id @default(autoincrement())
  facility_id      BigInt
  name             String   @db.VarChar(200)
  description      String?  @db.Text
  price            Decimal  @db.Decimal(12, 2)
  duration_minutes Int?
  is_active        Int      @default(1) @db.TinyInt

  facility Facility @relation(fields: [facility_id], references: [facility_id], onDelete: Cascade)
  appointments Appointment[]
  vaccines     ServiceVaccine[]

  @@map("tblService")
}

model Vaccine {
  vaccine_id        BigInt  @id @default(autoincrement())
  name              String  @unique @db.VarChar(200)
  manufacturer      String? @db.VarChar(150)
  country_of_origin String? @db.VarChar(100)
  dose_count        Int?
  description       String? @db.Text
  is_active         Int     @default(1) @db.TinyInt

  services ServiceVaccine[]

  @@map("tblVaccine")
}

model ServiceVaccine {
  service_id BigInt
  vaccine_id BigInt
  quantity   Int    @default(1)

  service Service @relation(fields: [service_id], references: [service_id])
  vaccine Vaccine @relation(fields: [vaccine_id], references: [vaccine_id])

  @@id([service_id, vaccine_id])
  @@map("tblServiceVaccine")
}

// --- 5. LỊCH HẸN & QUY TRÌNH KHÁM ---

model Slot {
  slot_id          BigInt     @id @default(autoincrement())
  facility_id      BigInt
  doctor_id        BigInt
  slot_date        DateTime   @db.Date
  start_time       DateTime   @db.Time
  end_time         DateTime   @db.Time
  duration_minutes Int        @default(30)
  available_count  Int        @default(10)
  status           SlotStatus @default(AVAILABLE)
  is_active        Int        @default(1) @db.TinyInt
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  facility Facility @relation(fields: [facility_id], references: [facility_id])
  doctor   Doctor   @relation(fields: [doctor_id], references: [doctor_id])
  appointment Appointment?

  @@map("tblSlots")
}

enum SlotStatus {
  AVAILABLE
  FULL
  CANCELLED
  INACTIVE
}

model Appointment {
  appointment_id   BigInt          @id @default(autoincrement())
  appointment_code String          @unique @db.VarChar(30)
  user_id          BigInt
  patient_id       BigInt
  facility_id      BigInt
  doctor_id        BigInt?
  slot_id          BigInt          @unique
  schedule_id      BigInt?
  service_id       BigInt?
  pre_visit_form_id BigInt?        @unique
  appointment_type AppointmentType
  appointment_date DateTime        @db.Date
  appointment_time DateTime        @db.Time
  status           AppointmentStatus @default(pending)
  symptoms_note    String?         @db.Text
  note             String?         @db.Text
  total_amount     Decimal         @db.Decimal(12, 2)
  
  cancellation_reason       String?  @db.VarChar(255)
  cancellation_requested_by BigInt?
  cancellation_requested_at DateTime?
  cancellation_approved_by  BigInt?
  cancellation_approved_at  DateTime?
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user     User           @relation(fields: [user_id], references: [user_id])
  patient  PatientProfile @relation(fields: [patient_id], references: [patient_id])
  facility Facility       @relation(fields: [facility_id], references: [facility_id])
  doctor   Doctor?        @relation(fields: [doctor_id], references: [doctor_id])
  slot     Slot           @relation(fields: [slot_id], references: [slot_id])
  schedule Schedule?      @relation(fields: [schedule_id], references: [scheduleId])
  service  Service?       @relation(fields: [service_id], references: [service_id])

  pre_visit_form          PreVisitForm?
  medical_record          MedicalRecord?
  vaccination_registration VaccinationRegistration?
  payments                Payment[]
  status_logs             AppointmentStatusLog[]
  notifications           Notification[]
  review                  DoctorReview?
  ai_triage_session       AiTriageSession?

  @@map("tblAppointment")
}

enum AppointmentType {
  consultation
  vaccination
}

enum AppointmentStatus {
  pending
  confirmed
  checked_in
  in_progress
  completed
  cancelled
  no_show
}

model AppointmentStatusLog {
  id              BigInt   @id @default(autoincrement())
  appointment_id  BigInt
  changed_by      BigInt
  changed_by_role ChangerRole
  from_status     String?
  to_status       String
  reason          String?  @db.VarChar(255)
  metadata        Json?
  created_at      DateTime @default(now())

  appointment Appointment @relation(fields: [appointment_id], references: [appointment_id])
  user        User        @relation(fields: [changed_by], references: [user_id])

  @@map("tblAppointmentStatusLogs")
}

enum ChangerRole {
  patient
  doctor
  admin
  receptionist
}

// --- 6. THANH TOÁN, THÔNG BÁO & AI TRIAGE ---

model Payment {
  payment_id       BigInt        @id @default(autoincrement())
  appointment_id   BigInt
  payment_method   PaymentMethod
  amount           Decimal       @db.Decimal(12, 2)
  transaction_code String?       @unique @db.VarChar(100)
  status           PaymentStatus @default(pending)
  paid_at          DateTime?
  refund_amount    Decimal?      @default(0) @db.Decimal(12, 2)
  refund_reason    String?       @db.VarChar(255)
  refunded_at      DateTime?
  retry_count      Int           @default(0)
  last_retry_at    DateTime?
  error_message    String?       @db.Text
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointment_id], references: [appointment_id], onDelete: Cascade)

  @@map("tblPayment")
}

enum PaymentMethod {
  cash
  vnpay
  momo
  zalopay
  credit_card
  bank_transfer
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
  refunding
}

model Notification {
  id              BigInt             @id @default(autoincrement())
  user_id         BigInt
  appointment_id  BigInt?
  type            NotificationType
  channel         NotificationChannel
  title           String             @db.VarChar(200)
  message         String             @db.Text
  delivery_status DeliveryStatus     @default(pending)
  is_read         Int                @default(0) @db.TinyInt
  read_at         DateTime?
  sent_at         DateTime?
  retry_count     Int                @default(0)
  last_retry_at   DateTime?
  error_message   String?            @db.Text
  created_at      DateTime           @default(now())

  user        User         @relation(fields: [user_id], references: [user_id])
  appointment Appointment? @relation(fields: [appointment_id], references: [appointment_id])

  @@map("tblNotifications")
}

enum NotificationType {
  appointment_reminder
  appointment_confirmed
  appointment_cancelled
  appointment_completed
  system
  promotional
}

enum NotificationChannel {
  sms
  email
  push
  in_app
}

enum DeliveryStatus {
  pending
  sent
  delivered
  failed
}

// --- 7. BỔ SUNG: MEDICAL RECORD, REVIEW, AI TRIAGE ---

model MedicalRecord {
  record_id         BigInt   @id @default(autoincrement())
  appointment_id    BigInt   @unique
  patient_id        BigInt
  doctor_id         BigInt
  pre_visit_form_id BigInt?
  symptoms          String?  @db.Text
  diagnosis         String   @db.Text
  icd10_codes       String?  @db.Text
  vital_signs       Json?
  treatment_plan    String?  @db.Text
  prescription      Json?
  follow_up_date    DateTime? @db.Date
  attachments       Json?
  is_locked         Int      @default(0) @db.TinyInt
  locked_at         DateTime?
  locked_by_user_id BigInt?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  appointment Appointment @relation(fields: [appointment_id], references: [appointment_id])
  patient     PatientProfile @relation(fields: [patient_id], references: [patient_id])
  doctor      Doctor      @relation(fields: [doctor_id], references: [doctor_id])

  @@map("tblMedicalRecord")
}

model DoctorReview {
  review_id      BigInt   @id @default(autoincrement())
  doctor_id      BigInt
  user_id        BigInt
  appointment_id BigInt?  @unique
  rating         Int      @db.TinyInt
  comment        String?  @db.Text
  is_visible     Int      @default(1) @db.TinyInt
  admin_reply    String?  @db.Text
  admin_reply_at DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  doctor      Doctor      @relation(fields: [doctor_id], references: [doctor_id])
  user        User        @relation(fields: [user_id], references: [user_id])
  appointment Appointment? @relation(fields: [appointment_id], references: [appointment_id])

  @@map("tblDoctorReview")
}

model PreVisitForm {
  id              BigInt     @id @default(autoincrement())
  appointment_id  BigInt     @unique
  form_version    String     @default("1.0") @db.VarChar(10)
  chief_complaint String     @db.Text
  symptoms        String?    @db.Text
  medical_history String?    @db.Text
  current_medications String? @db.Text
  allergies       String?    @db.Text
  extra_notes     String?    @db.Text
  status          FormStatus @default(DRAFT)
  submitted_by_user_id BigInt?
  submitted_at    DateTime?
  reviewed_by_user_id  BigInt?
  reviewed_at     DateTime?
  review_notes    String?    @db.Text
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  appointment Appointment @relation(fields: [appointment_id], references: [appointment_id])
  submitted_by User?       @relation("SubmittedByUser", fields: [submitted_by_user_id], references: [user_id])
  reviewed_by  User?       @relation("ReviewedByUser", fields: [reviewed_by_user_id], references: [user_id])

  @@map("tblPreVisitForms")
}

enum FormStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

model VaccinationRegistration {
  vaccination_registration_id BigInt   @id @default(autoincrement())
  appointment_id              BigInt   @unique
  contact_phone               String   @db.VarChar(20)
  contact_email               String?  @db.VarChar(150)
  screening_status            ScreeningStatus @default(pending)
  allergy_history             String?  @db.Text
  underlying_disease          String?  @db.Text
  current_medications         String?  @db.Text
  previous_vaccination_history String? @db.Text
  screening_result            String?  @db.Text
  screened_by_user_id         BigInt?
  screened_at                 DateTime?
  is_eligible_approved        Int      @default(0) @db.TinyInt
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  appointment Appointment @relation(fields: [appointment_id], references: [appointment_id])

  @@map("tblVaccinationRegistration")
}

enum ScreeningStatus {
  pending
  in_progress
  eligible
  ineligible
  need_review
  approved
}

model AiTriageSession {
  id                     BigInt       @id @default(autoincrement())
  user_id                BigInt
  appointment_id         BigInt?      @unique
  status                 TriageStatus @default(IN_PROGRESS)
  symptoms_input         String?      @db.Text
  urgency_level          UrgencyLevel?
  recommended_specialties Json?
  pre_visit_summary      Json?
  total_messages         Int          @default(0)
  is_completed           Int          @default(0) @db.TinyInt
  abandoned_at           DateTime?
  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt

  user        User         @relation(fields: [user_id], references: [user_id])
  appointment Appointment? @relation(fields: [appointment_id], references: [appointment_id])
  messages    AiTriageMessage[]

  @@map("tblAiTriageSessions")
}

enum TriageStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum UrgencyLevel {
  NORMAL
  SOON
  URGENT
}

model AiTriageMessage {
  id         BigInt   @id @default(autoincrement())
  session_id BigInt
  sender     SenderRole
  content    String   @db.Text
  metadata   Json?
  created_at DateTime @default(now())

  session AiTriageSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@map("tblAiTriageMessages")
}

enum SenderRole {
  PATIENT
  AI
}

